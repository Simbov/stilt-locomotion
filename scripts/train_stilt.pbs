#!/bin/bash -l
#PBS -N stilt-train
#PBS -l select=1:ncpus=8:ngpus=1:mem=32GB:gpu_id=H100
# Run 8 did 6000 iterations in 2h36m on this hardware; Runs 9 and 10 are the
# same size, so expect 2h30m-3h. 4h leaves headroom without asking the
# scheduler for a slot twice the size.
#
# Overrunning is not fatal: --agent.save-interval 500 means the worst case is
# losing the last <500 iterations and the ONNX export, not the run.
#PBS -l walltime=4:00:00
#PBS -m abe
#PBS -M n11298111@qut.edu.au
#PBS -j oe

cd $PBS_O_WORKDIR

# ── Environment setup ──────────────────────────────────────────────────────
if ! command -v uv &>/dev/null; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
export PATH="$HOME/.local/bin:$PATH"

uv sync --quiet

# ── Training ───────────────────────────────────────────────────────────────
# Run 10: from scratch (no --agent.resume; it defaults to False).
#
# THE ONE CHANGE FROM RUN 9: brace_stiffness_range 150-2000 -> 10-500 Nm/rad
# (env_cfgs.py, stilts_fitted). Run 9 walks on hardware with bare feet, but with
# stilts fitted the real brace adds only ~0-35 Nm/rad on top of the motor's own
# 28.5 Nm/rad PD. Trained against a near-rigid brace, Run 9 drives ankle pitch to
# -1.1..-1.9 rad targets at the 50 Nm limit and relies on the brace to stop it;
# on the robot the ankle sagged to -0.1..-0.25 rad (shin forward) and it drifted
# 30 cm sideways in 3.6 s (2026-09-25), or diverged outright (2026-09-17).
# See logs/hardware/2026-09-25/ankle_compare.png.
#
# Resuming from Run 9 is possible (same 480-wide actor) but NOT done: its ankle
# habit is exactly what this run has to unlearn.
#
# Everything else is Run 9 unchanged: one policy for both morphologies (50/50),
# ankles actuated, 5-frame history, base_lin_vel critic-only, air_time 0.5,
# command curriculum capped at 0.8 m/s.
#
# Watch, besides Episode_Metrics/{vel_error,upright}_stilts_{on,off}:
#   * whether stilts-on upright holds up — the softest envs (10 Nm/rad) are the
#     hardest; a stilts-on collapse with stilts-off fine means the range is too low.
#   * ankle torque in sim_telemetry.py --stilts afterwards: if the pitch motors
#     sit at the 50 Nm limit, the motors cannot replace the brace and it has to
#     be stiffened on the hardware instead.
export CUDA_VISIBLE_DEVICES=0
uv run python scripts/train_stilt.py Mjlab-Velocity-Flat-Stilt-G1 \
    --env.scene.num-envs 4096 \
    --agent.max-iterations 6000 \
    --agent.run-name run10-soft-brace \
    --agent.logger wandb \
    --agent.wandb-project stilt-locomotion \
    --agent.upload-model False \
    --agent.save-interval 500
